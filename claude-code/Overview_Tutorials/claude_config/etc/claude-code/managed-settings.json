{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf *)"
    ]
  },
  "allowManagedHooksOnly": false,
  "companyAnnouncements": [
    "Welcome! Company managed settings are located in /etc/claude-code folder"
  ],
  "statusLine": {
    "type": "command",
    "command": "/etc/claude-code/statusline.sh",
    "padding": 0
  }
}
