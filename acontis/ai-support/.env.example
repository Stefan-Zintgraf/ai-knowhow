# Copy to `.env` in the same directory you run the API from, then set secrets.
# See `config.example.yaml` for YAML settings; this file is for environment variables only.
# `support_rag.config.load_config` calls `load_dotenv()` so these are available before
# `config.yaml` is read (RAG_* still override YAML as documented in README).
#
# cp .env.example .env
# (edit .env — it is gitignored)

# Required for REST/MCP: Bearer tokens the server will accept. With RAG_UI_AUTH_FROM_ENV, the
# optional /ui/ form can be left empty — the server uses these env vars (see RAG_CONFIG / load_config).
RAG_SERVICE_TOKEN=dev-service
RAG_ADMIN_TOKEN=dev-admin

# If set, /ui/ API accepts requests without Authorization (uses the tokens above on the server only). Do
# not enable in untrusted or production-like environments; anyone who can reach the RAG port can use the UI.
RAG_UI_AUTH_FROM_ENV=1

# Optional: full path to AnythingLLM.exe when not under %LOCALAPPDATA%\Programs\AnythingLLM\ (E2E scripts)
# ANYTHINGLLM_DESKTOP_EXE=C:\Path\To\AnythingLLM.exe

# Optional: non-default path to the YAML file (default: `config.yaml` in CWD)
# RAG_CONFIG=config.yaml

# Optional overrides (also valid in the shell; see `config.py` / README)
# RAG_LLM_GATEWAY__BASE_URL=http://127.0.0.1:4000
# Optional: embed via Ollama /api/embed (bypasses LiteLLM) — set when using config.e2e and local Ollama
# RAG_LLM_GATEWAY__OLLAMA_EMBED_BASE_URL=http://127.0.0.1:11434
# RAG_LLM_GATEWAY__OLLAMA_EMBED_MODEL=all-minilm
# If LiteLLM (or the gateway) uses a master / API key, set the same value here (fixes 4xx/5xx to /v1/chat):
# RAG_LLM_GATEWAY__API_KEY=
# RAG_QDRANT__URL=http://127.0.0.1:6333
# AnythingLLM HTTP API (dual-RAG). Required for /ui/ "Ingest to AnythingLLM" and vector-search:
# copy a generated key from AnythingLLM Desktop (in-app: Entwickler-API / API keys; not http://127.0.0.1:3001/settings/... in a browser), then set (uncomment) one of:
# RAG_ANYTHING_LLM__API_KEY=your_key_here
# RAG_ANYTHING_LLM__BASE_URL=http://127.0.0.1:3001
