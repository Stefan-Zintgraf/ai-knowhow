# Copy to .env and fill in. Do not commit .env.
KERIO_BASE_URL=https://remote.example.com
KERIO_USERNAME=
KERIO_PASSWORD=

# Optional (defaults applied in code if omitted)
# KERIO_APP_NAME=kerio-mail-read
# KERIO_APP_VENDOR=acontis
# KERIO_APP_VERSION=1.0
# KERIO_VERIFY_SSL=true

# Optional: set to 1 to run pytest integration tests against this server (needs credentials above).
# Default / unset: integration tests are skipped so CI and local runs need no secrets.
# KERIO_INTEGRATION=0
