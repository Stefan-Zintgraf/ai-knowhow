flowchart LR
    subgraph REQ["📦 Single Request"]
      direction TB
      SP["🛠️ System Prompt"]
      UP["💬 User Prompt"]
      H["🕘 Conversation History"]
    end
    REQ --> LLM["🧠 LLM (stateless)"]
    LLM --> A["✅ Assistant Answer"]

    style SP  fill:#FCE7C8,stroke:#B08968,color:#000
    style UP  fill:#CDE7F0,stroke:#3D7EA6,color:#000
    style H   fill:#EEE,stroke:#666,color:#000
    style LLM fill:#F5F5F5,stroke:#222,stroke-width:2px,color:#000
    style A   fill:#D5E8D4,stroke:#2E7D32,color:#000
