<UserControl x:Class="OutlookClaudeAddin.UI.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OutlookClaudeAddin.UI.Converters"
             Background="#1E1E1E">

    <UserControl.Resources>
        <converters:MessageAlignmentConverter x:Key="AlignmentConverter"/>
        <converters:MessageBackgroundConverter x:Key="BackgroundConverter"/>
        <converters:MessageForegroundConverter x:Key="ForegroundConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#252525" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Claude Email Assistant"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Natürliche Sprache → E-Mail-Aktionen"
                               Foreground="#888888"
                               FontSize="10"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Neu"
                        Command="{Binding NewChatCommand}"
                        Background="#333333"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="10,4"
                        Cursor="Hand"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Message List -->
        <ScrollViewer Grid.Row="1"
                      x:Name="MessageScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      Background="#1E1E1E"
                      Padding="8">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4,3"
                                Padding="10,7"
                                CornerRadius="8"
                                MaxWidth="320"
                                HorizontalAlignment="{Binding Role, Converter={StaticResource AlignmentConverter}}"
                                Background="{Binding Role, Converter={StaticResource BackgroundConverter}}">
                            <TextBlock Text="{Binding Content}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{Binding Role, Converter={StaticResource ForegroundConverter}}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Loading Indicator -->
        <Border Grid.Row="2"
                Background="#252525"
                Padding="8,4"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <TextBlock Text="Claude denkt nach..."
                       Foreground="#888888"
                       FontSize="11"
                       FontStyle="Italic"/>
        </Border>

        <!-- Input Area -->
        <Border Grid.Row="3"
                Background="#252525"
                BorderBrush="#333333"
                BorderThickness="0,1,0,0"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="InputBox"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="False"
                         TextWrapping="Wrap"
                         MaxHeight="80"
                         VerticalScrollBarVisibility="Auto"
                         Background="#333333"
                         Foreground="White"
                         CaretBrush="White"
                         BorderThickness="0"
                         Padding="8,6"
                         FontSize="12"
                         VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="1"
                        Content="→"
                        Command="{Binding SendMessageCommand}"
                        Margin="6,0,0,0"
                        Padding="12,6"
                        Background="#0078D4"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Cursor="Hand"
                        VerticalAlignment="Stretch"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
