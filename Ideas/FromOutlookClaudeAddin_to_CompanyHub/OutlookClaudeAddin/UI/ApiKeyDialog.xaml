<Window x:Class="OutlookClaudeAddin.UI.ApiKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude API Key einrichten"
        Width="500" Height="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Claude API Key einrichten"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- Step-by-step instructions -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,6">
                <Run FontWeight="SemiBold" Foreground="#0078D4">1.</Run>
                <Run> Konto erstellen auf </Run>
                <Hyperlink x:Name="ConsoleLink"
                           Foreground="#0078D4"
                           TextDecorations="Underline"
                           Click="ConsoleLink_Click">console.anthropic.com</Hyperlink>
            </TextBlock>
            <TextBlock Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,6">
                <Run FontWeight="SemiBold" Foreground="#0078D4">2.</Run>
                <Run> Guthaben aufladen (ab 5 $) unter Billing</Run>
            </TextBlock>
            <TextBlock Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,6">
                <Run FontWeight="SemiBold" Foreground="#0078D4">3.</Run>
                <Run> API Key erstellen (</Run>
                <Hyperlink x:Name="KeysLink"
                           Foreground="#0078D4"
                           TextDecorations="Underline"
                           Click="KeysLink_Click">direkt zur Key-Seite</Hyperlink>
                <Run>) und unten einfügen</Run>
            </TextBlock>
        </StackPanel>

        <!-- Cost hint -->
        <Border Grid.Row="2"
                Background="#2D2D2D"
                CornerRadius="4"
                Padding="10,8"
                Margin="0,0,0,14">
            <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap">
                Jeder Benutzer benötigt seinen eigenen API Key.
                Kosten: ca. 0,01–0,05 $ pro Anfrage.
            </TextBlock>
        </Border>

        <!-- API Key input -->
        <TextBox Grid.Row="3"
                 x:Name="ApiKeyTextBox"
                 Background="#333333"
                 Foreground="White"
                 CaretBrush="White"
                 BorderThickness="1"
                 BorderBrush="#555555"
                 Padding="8,6"
                 FontSize="12"
                 FontFamily="Consolas"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Abbrechen"
                    Width="90"
                    Padding="0,7"
                    Background="#333333"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CancelButton_Click"
                    Margin="0,0,8,0"/>
            <Button Content="Speichern"
                    Width="90"
                    Padding="0,7"
                    Background="#0078D4"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsDefault="True"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
